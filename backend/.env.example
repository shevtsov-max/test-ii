# Переменные бэкенда для запуска БЕЗ Docker (php artisan …). В Docker их задаёт корневой .env — см. docker/README.md.
APP_NAME="Родословная"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rodoslovnaya
DB_USERNAME=rodoslovnaya
DB_PASSWORD=secret

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MEDIA_DISK=media

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="noreply@rodoslovnaya.local"
MAIL_FROM_NAME="${APP_NAME}"

OCTANE_SERVER=frankenphp
AUTH_ACCESS_TTL=60
AUTH_REFRESH_TTL_DAYS=60

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
SUPPORT_EMAIL=support@example.com
