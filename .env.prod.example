# ─────────────────────────────────────────────────────────────────────────────
# ПРОДАКШН. На сервере: cp .env.prod.example .env, заполните все значения «<…>»,
# затем: docker compose -f docker-compose.prod.yml up -d --build   (подробно — docs/deploy.md)
# Файл .env содержит пароли: не коммитьте его и не передавайте по почте.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Прапра"
# openssl rand -base64 32  →  APP_KEY=base64:<результат>
APP_KEY=base64:<сгенерируйте>
APP_DEBUG=false
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
LOG_LEVEL=warning

# Адрес сайта (ссылки в письмах, вебхук Telegram)
APP_URL=https://<ваш-домен>
FRONTEND_URL=https://<ваш-домен>
# Для Caddy: домен без https:// — сертификат выпустится автоматически.
# Для проверки на сервере без домена можно указать http://<IP-сервера>
# Например: SITE_ADDRESS=praprapra.ru
SITE_ADDRESS=<ваш-домен>
# Почта для уведомлений Let's Encrypt о сертификатах
ACME_EMAIL=<ваша-почта>

# Где на диске сервера хранятся база, файлы и сертификаты
DATA_DIR=/srv/rodoslovnaya

# База данных. Пароли: openssl rand -base64 24 | tr -d '/+=' 
DB_CONNECTION=mysql
DB_DATABASE=rodoslovnaya
DB_USERNAME=rodoslovnaya
DB_PASSWORD=<сгенерируйте>
DB_ROOT_PASSWORD=<сгенерируйте>

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
MEDIA_DISK=media
MEDIA_MAX_UPLOAD_MB=20

# Почта (SMTP). Например, Unisender Go, Yandex Postbox, Mail.ru для бизнеса.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=<smtp-сервер>
MAIL_PORT=465
MAIL_USERNAME=<логин>
MAIL_PASSWORD=<пароль>
MAIL_FROM_ADDRESS=noreply@<ваш-домен>
MAIL_FROM_NAME="Прапра"

# Telegram-бот (необязательно): токен от @BotFather, имя бота без @,
# секрет вебхука — любая случайная строка: openssl rand -hex 32
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Сведения об операторе персональных данных — показываются в юридических документах сайта
SUPPORT_EMAIL=<почта-поддержки>
OPERATOR_NAME=<ИП Иванов Иван Иванович или ООО «…»>
OPERATOR_INN=<ИНН>
OPERATOR_OGRN=<ОГРН/ОГРНИП>
OPERATOR_ADDRESS=<адрес для обращений>
