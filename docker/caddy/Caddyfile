# Caddy: HTTPS (сертификат Let's Encrypt выпускается и продлевается сам), статика фронтенда, прокси на бэкенд.
# SITE_ADDRESS — домен (rodoslovnaya.ru) или http://localhost:8080 для проверки без HTTPS.
{
	email {$ACME_EMAIL}
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip
	request_body {
		max_size 30MB
	}

	# API, файлы, вебхук бота и проверка здоровья — в бэкенд (Laravel Octane)
	@backend path /graphql /api/* /files/* /telegram/* /up
	handle @backend {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Фронтенд (SPA). index.html и service worker не кешируются — обновления приходят сразу
	handle {
		root * /srv
		@nocache path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	log {
		output stdout
		format console
	}
}
