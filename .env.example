# ─────────────────────────────────────────────────────────────────────────────
# Среда РАЗРАБОТКИ. Скопируйте: cp .env.example .env — и запускайте: docker compose up -d
# Значения ниже подходят для локальной работы как есть. Для продакшна — .env.prod.example.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Родословная"
# Ключ шифрования Laravel — ТОЛЬКО для разработки. В продакшне сгенерируйте свой: openssl rand -base64 32
APP_KEY=base64:G5pzH6tDWljkn5n27f3wkQZV1Uw/b28QhzPwY1RAt5Y=
APP_DEBUG=true
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
LOG_LEVEL=debug

# База данных (контейнер mysql)
DB_CONNECTION=mysql
DB_DATABASE=rodoslovnaya
DB_USERNAME=rodoslovnaya
DB_PASSWORD=rodoslovnaya
DB_ROOT_PASSWORD=root

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
MEDIA_DISK=media

# Почта: в разработке все письма попадают в Mailpit — http://localhost:8025
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=noreply@rodoslovnaya.local
MAIL_FROM_NAME="Родословная"

# Telegram-бот для уведомлений о днях рождения (необязательно).
# Создайте бота у @BotFather и впишите токен и имя (без @). В разработке сообщения получает контейнер bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

SUPPORT_EMAIL=support@example.com

# Порты на вашем компьютере
FRONTEND_PORT=5173
BACKEND_PORT=8000
MAILPIT_PORT=8025
DB_FORWARD_PORT=3306
