# Настройки сборки (скопируйте в .env.local и измените при необходимости).
# Без .env приложение работает полностью в браузере: учётные записи и древа — в IndexedDB.

# Откуда берутся данные: local — браузер (по умолчанию), graphql — сервер (схема: docs/api/schema.graphql)
VITE_API_MODE=local

# Адрес GraphQL API (для VITE_API_MODE=graphql)
VITE_GRAPHQL_URL=https://api.example.com/graphql

# Вход через соцсети (только с сервером), через запятую: google,vk,yandex
VITE_OAUTH_PROVIDERS=

# Адреса страниц: hash — /#/app (работает на любом статическом хостинге, в том числе GitHub Pages),
# history — «чистые» /app (нужен сервер, отдающий index.html на любой путь)
VITE_ROUTER_MODE=hash

# Почта поддержки в подвале, справке и правовых документах
VITE_SUPPORT_EMAIL=support@example.com
